from numpy import *
import string,re,sys,glob,os
import floyds
import datetime
import time
from astropy.io import fits
from argparse import ArgumentParser
import json
import requests
try:
    import MySQLdb as msql
except ImportError:
    import pymysql as msql

workdirectory = os.getenv('LCOSNDIR', '/supernova/')
if not workdirectory.endswith('/'):
    workdirectory += '/'


def readconfig():
    config = {}
    for line in open(os.path.join(workdirectory, 'configure')):
        fields = line.split()
        if len(fields) >= 2:
            config[fields[0]] = fields[1].strip('\'"')
    return config


config = readconfig()
conn = msql.connect(host=config['hostname'], user=config['mysqluser'], passwd=config['mysqlpasswd'], db=config['database'])


def execute(sql, values=None):
    cursor = conn.cursor(msql.cursors.DictCursor)
    cursor.execute(sql, values)
    rows = cursor.fetchall()
    conn.commit()
    cursor.close()
    return rows


def query(commands):
    rows = ''
    for command in commands:
        rows = execute(command)
    return rows


def getfromdataraw(table, column, value, column2='*'):
    return execute('select ' + column2 + ' from ' + table + ' where ' + column + '=%s', (value,))


def getfromcoordinate(ra0, dec0, distance):
    return query(['set @sc = pi()/180', 'set @ra = ' + str(ra0), 'set @dec = ' + str(dec0), 'set @distance = ' + str(distance),
                  'SELECT *,abs(2*asin( sqrt( sin((a.dec0-@dec)*@sc/2)*sin((a.dec0-@dec)*@sc/2) + '
                  'cos(a.dec0*@sc)*cos(@dec*@sc)*sin((a.ra0-@ra)*@sc/2)*sin((a.ra0-@ra)*@sc/2.0) )))*180/pi() as hsine '
                  'FROM targets as a HAVING hsine<@distance order by a.ra0 desc'])


def gettargetid(_name, _ra, _dec, _radius=.01, verbose=False):
    lista = ''
    if _name:
        lista = execute('select distinct(r.name), r.targetid, t.id, t.ra0, t.dec0 from targetnames as r join targets as t '
                        'where r.name like %s and t.id=r.targetid', ('%' + _name.replace(' ', '%'),))
    elif _ra and _dec:
        if ':' in str(_ra):
            _ra, _dec = deg2HMS(_ra, _dec)
        lista = getfromcoordinate(_ra, _dec, _radius)
        if verbose:
            print(lista)
    ids = set(row['id'] for row in lista)
    if len(ids) == 1:
        return lista[0]['id']
    if len(ids) > 1 and 'hsine' in lista[0]:
        return sorted(lista, key=lambda row: row['hsine'])[0]['id']
    return ''


def insert_values(table, values):
    values = dict((key, val) for key, val in values.items() if val not in ['NaN', 'UNKNOWN', 'N/A', None, ''])
    if 'datecreated' not in values and table in ['instruments', 'spec', 'targetnames', 'targets', 'telescopes']:
        values['datecreated'] = str(datetime.datetime.utcnow())
    columns = list(values)
    execute('INSERT INTO ' + table + ' (' + ', '.join(columns) + ') VALUES (' + ', '.join(['%s'] * len(columns)) + ')',
            [values[column] for column in columns])


def updatevalue(column, value, filename):
    execute('UPDATE spec SET ' + column + '=%s WHERE filename=%s', (value, filename))


def deletefromspec(value, column):
    execute('delete from spec where ' + column + '=%s', (value,))


def deg2HMS(ra='', dec=''):
    RA, DEC = '', ''
    if dec:
        if str(dec).count(':') == 2:
            dec0, dec1, dec2 = [float(part) for part in dec.split(':')]
            if '-' in str(dec0):
                DEC = (-1) * ((dec2 / 60. + dec1) / 60. + ((-1) * dec0))
            else:
                DEC = (dec2 / 60. + dec1) / 60. + dec0
        else:
            dec0 = (-1) * abs(int(dec)) if str(dec)[0] == '-' else abs(int(dec))
            dec1 = int((abs(dec) - abs(dec0)) * 60)
            dec2 = (((abs(dec)) - abs(dec0)) * 60 - abs(dec1)) * 60
            DEC = '00'[len(str(dec0)):] + str(dec0) + ':' + '00'[len(str(dec1)):] + str(dec1) + ':' + '00'[len(str(int(dec2))):] + str(dec2)
    if ra:
        if str(ra).count(':') == 2:
            ra0, ra1, ra2 = [float(part) for part in ra.split(':')]
            RA = ((ra2 / 60. + ra1) / 60. + ra0) * 15.
        else:
            ra0 = int(ra / 15.)
            ra1 = int(((ra / 15.) - ra0) * 60)
            ra2 = ((((ra / 15.) - ra0) * 60) - ra1) * 60
            RA = '00'[len(str(ra0)):] + str(ra0) + ':' + '00'[len(str(ra1)):] + str(ra1) + ':' + '00'[len(str(int(ra2))):] + str(ra2)
    if ra and dec:
        return RA, DEC
    return RA or DEC

