workdirectory = os.path.join(os.getenv('LCOSNDIR', '/supernova/'), '')
conn = msql.connect(host=os.getenv('LCOSNDBHOST', 'supernova.sci.lco.gtn'), user=os.getenv('LCOSNDBUSER', 'supernova'),
                    passwd=os.getenv('LCOSNDBPASS', 'supernova'), db=os.getenv('LCOSNDBNAME', 'supernova'))

#################################################################################

def query(command, args=None):
    cursor = conn.cursor(msql.cursors.DictCursor)
    cursor.execute(command, args)
    rows = cursor.fetchall()
    conn.commit()
    cursor.close()
    return rows

def insert_values(table, values):
    values = dict((key, val) for key, val in values.items() if val not in ['NaN', 'UNKNOWN', 'N/A', None, ''])
    if 'datecreated' not in values:
        values['datecreated'] = str(datetime.datetime.utcnow())
    query('insert into ' + table + ' (' + ', '.join(values) + ') values (' + ', '.join(['%s'] * len(values)) + ')',
          list(values.values()))

def sexa2deg(ra, dec):
    coord = SkyCoord(str(ra), str(dec), unit=(u.hourangle, u.deg))
    return coord.ra.deg, coord.dec.deg

def getfromcoordinate(ra, dec, distance):
    return query('select *, abs(2*asin(sqrt(sin((a.dec0-%s)*pi()/360)*sin((a.dec0-%s)*pi()/360) + cos(a.dec0*pi()/180)*cos(%s*pi()/180)'
                 '*sin((a.ra0-%s)*pi()/360)*sin((a.ra0-%s)*pi()/360))))*180/pi() as hsine from targets as a having hsine<%s order by hsine',
                 [dec, dec, dec, ra, ra, distance])

def gettargetid(name, ra, dec, radius):
    if name:
        rows = query('select distinct(r.name), r.targetid, t.id, t.ra0, t.dec0 from targetnames as r join targets as t '
                     'where r.name like %s and t.id=r.targetid', ['%' + name.replace(' ', '%')])
    else:
        rows = getfromcoordinate(ra, dec, radius)
    ids = set(row['id'] for row in rows)
    if len(ids) == 1:
        return rows[0]['id']
    if len(ids) > 1 and 'hsine' in rows[0]:
        return rows[0]['id']
    return ''

#################################################################################

def JDnow(datenow='',verbose=False):
    _JD0=2455927.5
    if not datenow:
        datenow=datetime.datetime(time.gmtime().tm_year, time.gmtime().tm_mon, time.gmtime().tm_mday, time.gmtime().tm_hour, time.gmtime().tm_min, time.gmtime().tm_sec)
    _JDtoday=_JD0+(datenow-datetime.datetime(2012, 01, 01,00,00,00)).seconds/(3600.*24)+\
              (datenow-datetime.datetime(2012, 01, 01,00,00,00)).days
    if verbose: print 'JD= '+str(_JDtoday)
    return _JDtoday

def MJDnow(datenow='',verbose=False):
    _JD0=2455927.5
    if not datenow:
        datenow=datetime.datetime(time.gmtime().tm_year, time.gmtime().tm_mon, time.gmtime().tm_mday, time.gmtime().tm_hour, time.gmtime().tm_min, time.gmtime().tm_sec)
    _JDtoday=_JD0+(datenow-datetime.datetime(2012, 01, 01,00,00,00)).seconds/(3600.*24)+\
              (datenow-datetime.datetime(2012, 01, 01,00,00,00)).days
    if verbose: print 'JD= '+str(_JDtoday)
    return _JDtoday-2400000.5

def archivereducedspectrum(img):
    hdulist = fits.open(img, mode='update')
    hdr = hdulist[0].header
    _targid=targimg(img,True)
    print 'targid '+str(_targid)
    if 'REDUCER' in hdr:
        _reducer = hdr.get('REDUCER')
        print 'reduced by', _reducer
    else:
        _reducer = None
    #    telescope
    if 'TELESCOP' in hdr:     _telescope=hdr.get('TELESCOP')
    else:                     _telescope=''
    #    object
    if 'object' in hdr: _object=hdr.get('object')
    elif 'objcat' in hdr: _object=hdr.get('objcat') # TNG format
    else: _object='spectrum'
    _object=re.sub('\}','', _object)
    _object=re.sub('\{','', _object)
    _object=re.sub('\[','', _object)
    _object=re.sub('\]','', _object)
    _object=re.sub('\(','', _object)
    _object=re.sub('\)','', _object)
#    _object=re.sub('-','', _object)
    _object=re.sub(' ','', _object)
    #    dateobs
    if 'DATE-OBS' in hdr:  
        _dateobs=hdr.get('DATE-OBS')
        if 'T' in _dateobs: _dateobs=string.split(_dateobs,'T')[0]
    else:     _dateobs=''
    #   UT
    if 'UTSTART' in hdr:  _ut=hdr.get('UTSTART')
    elif 'UT' in hdr: _ut=hdr.get('UT')
    else:
        _ut=hdr.get('DATE-OBS')
        if 'T' in _ut:    _ut=string.split(_ut,'T')[1]
    # ra and  dec
    _ra=hdr.get('RA')
    _dec=hdr.get('DEC')
    if ':' in str(_ra):      _ra,_dec=sexa2deg(_ra,_dec)
    # JD
    if 'JD' in hdr: _mjd=hdr.get('JD')-2400000.5
    elif 'JD-OBS' in hdr: _mjd=hdr.get('JD-OBS')-2400000.5
    elif 'MJD' in hdr: _mjd=hdr.get('MJD')
    elif 'MJD-OBS' in hdr: _mjd=hdr.get('MJD-OBS')
    elif 'DATE-OBS' in hdr: 
        dd=''
        try:
            dd=datetime.datetime.strptime(hdr.get('DATE-OBS')[0:-6],'%Y-%m-%dT%H:%M:%S')
        except:
            try:
                dd=datetime.datetime.strptime(hdr.get('DATE-OBS')[0:-6],'%Y-%m-%dT%H:%M')
            except: pass
        if dd:     _mjd=MJDnow(dd,False)
        else:      _mjd=None
    

    if _telescope in ['fts','ftn','2m0a','2m0-01','2m0-02']:
        dictionary={'dateobs':_dateobs,'exptime':hdr.get('exptime'), 'filter':hdr.get('filter'),'mjd':_mjd,\
                    'telescope':_telescope,'airmass':hdr.get('airmass'),'objname':_object,'ut':_ut,\
                    'instrument':hdr.get('instrume'),'ra0':_ra,'dec0':_dec,'slit':hdr.get('APERWID'),\
                    'targetid':_targid,'grism':re.sub('/','',hdr.get('GRISM')), 'original':hdr.get('arcfile'),'reducer':_reducer,\
                    'dayobs':hdr.get('DAY-OBS')}
        if 'TRACKNUM' in hdr:
            try:
#                print hdr['TRACKNUM']
#                dictionary['tracknumber']=int(hdr['TRACKNUM'])
#                print 'select r.groupidcode from obslog as o join obsrequests as r where o.requestsid=r.id and o.tracknumber='+str(int(hdr['TRACKNUM']))
                gruppo=query('select r.groupidcode from obslog as o join obsrequests as r where o.requestsid=r.id and o.tracknumber=%s',
                             [int(hdr['TRACKNUM'])])
                if len(gruppo):
                    dictionary['groupidcode']=gruppo[0]['groupidcode']
            except:
                pass

    elif 'gemini' in _telescope.lower():
        if 'south' in _telescope.lower(): _telescope='gs'
        else: _telescope='gn'
        dictionary={'dateobs':_dateobs,'exptime':hdr.get('exptime'), 'filter':hdr.get('filter'),'mjd':_mjd,\
                    'telescope':_telescope,'airmass':hdr.get('AIRMASS'),'objname':_object,'ut':_ut,\
                    'instrument':hdr.get('INSTRUME'),'ra0':_ra,'dec0':_dec,'slit':hdr.get('slit'),\
                    'targetid':_targid,'grism':hdr.get('GRATING'),'original':hdr.get('arcfile'),'reducer':_reducer}

    elif 'TNG' in _telescope:
        dictionary={'dateobs':_dateobs,'exptime':hdr.get('exptime'), 'filter':hdr.get('flt_id'),'mjd':_mjd,\
                    'telescope':_telescope,'airmass':hdr.get('airmass'),'objname':_object,'ut':_ut,\
                    'instrument':hdr.get('instrume'),'ra0':_ra,'dec0':_dec,'slit':hdr.get('slt_id'),\
                    'targetid':_targid,'grism':hdr.get('grm_id'),'original':hdr.get('filename'),'reducer':_reducer,\
                    'observer':hdr.get('observer')}

    else:
        dictionary={'dateobs':_dateobs,'exptime':hdr.get('exptime'), 'filter':hdr.get('filter'),'mjd':_mjd,\
                    'telescope':_telescope,'airmass':hdr.get('airmass'),'objname':_object,'ut':_ut,\
                    'instrument':hdr.get('instrume'),'ra0':_ra,'dec0':_dec,'slit':hdr.get('slit'),\
                    'targetid':_targid,'grism':hdr.get('GRISM'),'original':hdr.get('arcfile'),'reducer':_reducer,\
                    'observer':hdr.get('observer')}

    dictionary['filename']=string.split(img,'/')[-1]
    _dir=re.sub(string.split(img,'/')[-1],'',img)
    dictionary['filepath']=_dir
    return dictionary

########################################

def targimg(img,verbose=False):
    _targetid=''
    hdrt = fits.getheader(img)
    try:
        _ra=hdrt.get('RA')
        _dec=hdrt.get('DEC')
        if ':' in str(_ra):         _ra,_dec=sexa2deg(_ra,_dec)
    except:
        print 'warning: file corrupted'
        return ''
    if 'object' in hdrt:
        _object=hdrt.get('object')
    elif 'objcat' in hdrt:
        _object=hdrt.get('objcat')
    else: _object=''
    _object=re.sub(' ','',_object)
    _object=re.sub('\[','',_object)
    _object=re.sub('\]','',_object)

    if verbose: 
        print _ra,_dec,_object
    if _object: _targetid=gettargetid(_object,'','',0.01)
    if not _targetid:
       if verbose:
           print '\n use coordinate to identify target id '
           print _ra,_dec
       _targetid=gettargetid('',_ra,_dec,0.1)   

    if not _targetid:
       dictionary={'ra0':_ra,'dec0':_dec}
       insert_values('targets',dictionary)
       bb=getfromcoordinate(_ra, _dec,.000156)
       dictionary1={'name':_object,'targetid':bb[0]['id']}
       insert_values('targetnames',dictionary1)
       _targetid=bb[0]['id']
    return _targetid

def uploadspectrum(img, _output, _force, reducer=None, post='add'):
    note = '\ninput = '+img+'\n'
    hdulist = fits.open(img, mode='update')
    hdr = hdulist[0].header
    
    if 'REDUCER' in hdr:
        if reducer is None:
            reducer = hdr['REDUCER']
        elif hdr['REDUCER'] != reducer:
            print 'Reducer given with -r and reducer in header are different. Which one is correct?'
            while True:
                choice = raw_input('(1) {} \t (2) {} '.format(reducer, hdr['REDUCER']))
                if choice == '1':
                    break
                elif choice == '2':
                    reducer = hdr['REDUCER']
                    break
    elif reducer is None and fullname is not None:
        reducer = raw_input('Who reduced this spectrum? [{}] '.format(fullname))
        if not reducer:
            reducer = fullname
    elif reducer is None:
        names = query('select distinct reducer from spec')
        for name in names:
            if name['reducer']: 
                print name['reducer']
        reducer = raw_input('Who reduced this spectrum? (Copy and paste from above if possible.) ')
    if reducer:
        hdr['REDUCER'] = (reducer, 'User who reduced the spectrum')
        hdulist.close()

    dictionary = archivereducedspectrum(img)
    _tel = re.sub(' ','',dictionary['telescope'])

###################################### # gemini files in jerod format needs some trick
    if 'gemini' in _tel.lower():      
        data,hdr0 = fits.getdata(img, 'sci', header=True)
        try:        hdr0.__delitem__('AIRMASS')
        except:     hdr0.remove('AIRMASS') 
        hed=['TELESCOP','OBSERVAT','RA','DEC','UT','ST','EXPTIME','MASKNAME','GRATING','CENTWAVE','OBSMODE','GAIN','RDNOISE','MJD-OBS',\
                 'PIXSCALE','DATE-OBS','AIRMASS']
        for jj in hed:
            hdr0[jj] = hdr[jj]
        if 'south' in _tel.lower(): _tel='gs'
        else: _tel='gn'
        fits.writeto(re.sub('.fits','0.fits',img), float32(data), hdr0)
        img=re.sub('.fits','0.fits',img)
############################################# 

    _grism = dictionary['grism']
    _date = re.sub('-','',dictionary['dateobs'])
    if 'T' in _date: string.split(_date,'T')[0]
    _ut = dictionary['ut']
    _object = dictionary['objname']
    if not _output:
        _output=re.sub('/','',str(_object))+'_'+str(_date)+'_'+str(_grism)+'_'+re.sub(':','',str(_ut))+'.fits'
    
    if _tel:
        directory = workdirectory + 'data/WEB/floyds/'+_date+'_'+_tel+'/'
        note += 'telescope = '+_tel+'\n'
    else:
        directory = workdirectory + 'data/WEB/floyds/'+_date+'_other/'
        note+= 'WARNING: telescope name not in header\n'
    dictionary['filepath'] = directory
    dictionary['filename'] = _output

    if not dictionary['objname']: note += 'ERROR: OBJECT not defined '
    else:                         note += 'objname = '+str(dictionary['objname'])+'\n'
    if not dictionary['ra0']:     note += 'ERROR: RA not defined \n'
    else:                         note += 'RA = '+str(dictionary['ra0'])+'\n'
    if not dictionary['dec0']:    note += 'ERROR: DEC not defined \n'
    else:                         note += 'DEC = '+str(dictionary['dec0'])+'\n'
    if not dictionary['targetid']: note+= 'ERROR: TARGID not defined \n'
    else:                         note += 'targid = '+str(dictionary['targetid'])+'\n'
    if not dictionary['dateobs']: note += 'ERROR: DATE-OBS not defined \n'
    else:                         note += 'dateobs = '+str(dictionary['dateobs'])+'\n'

    if 'ERROR' in note: 
        return note

    if os.path.isdir(directory): print directory, 'already exists'
    else:
      os.system('mkdir ' + directory)
      print 'creating', directory

    cont = False
    adding = False
    while not cont:
        file_exists = os.path.isfile(directory+_output)
        db_original_exists = query('select id, filename, filepath from spec where original=%s', [hdr['origname']]) if 'origname' in hdr else False
        if file_exists and _force:
            replace = 'o'
            cont = True
            print 'replacing existing file'
        elif file_exists: # if -f not given, prompt to choose
            replace = raw_input('File already exists. What do you want to do? [o]verwrite/[a]dd/[n]othing ')
            if replace=='o':
                _force = True
                cont = True
                print 'replacing existing file'
            elif replace=='a':
                _output = re.sub('.fits','a.fits',_output)
                dictionary['filename'] = _output
                print 'changing output to',_output
                adding = True
            elif replace=='n':
                cont = True
                print 'file not changed'
        elif db_original_exists and not adding:
            print 'Another spectrum from this original already exists.'
            fullpath = db_original_exists[0]['filepath'] + db_original_exists[0]['filename']
            print fullpath
            if _force:
                print 'Deleting that file and database entry.'
            else:
                delete = raw_input('Do you want to delete this file and database entry before archiving? [y/[n]] ')
            if _force or delete == 'y':
                os.system('rm -v ' + fullpath + ' ' + fullpath.replace('.fits', '.ascii'))
                query('delete from spec where id=%s', [db_original_exists[0]['id']])
            else:
                cont = True
                adding = True
                print 'other file not changed'
        else: # file doesn't exist
            _force = True
            cont = True
            print 'adding file'
    if _force or adding:
        os.system('cp '+img+' '+directory+_output)
        xx,yy=floyds.readspectrum(img)
        data=zip(xx,yy)
        savetxt(re.sub('.fits','.ascii',directory+_output),data)
        note += 'output = '+_output+'\n'

    filename = os.path.basename(_output)
    dbentry_exists = query('select filename from spec where filename=%s', [filename])
    if dbentry_exists and not _force: # if -f not given and 'n' chosen above, prompt to choose
        update = raw_input('Spectum already in database. Update entry? [[y]/n] ')
        if update=='n':
            print 'database not changed'
            return note

    if _tel:            # telescope is in the header
        _telid = query('select id from telescopes where name=%s', [_tel])
        if not _telid:  # telescope is not yet in the telescopes table
            print 'Telescope ',_tel,' not recognized.  Adding to telescopes table.'
            shortname = raw_input('What is the short name of this telescope (e.g., FTN, COJ, LSC)? ')
            insert_values('telescopes',{'name':_tel,'shortname':shortname})
            _telid = query('select id from telescopes where name=%s', [_tel])
        dictionary['telescopeid'] = str(_telid[0]['id'])

    _inst = dictionary['instrument']
    if _inst:
        _instid = query('select id from instruments where name=%s', [_inst])
        if not _instid:  # instrument is not yet in the instruments table
            print 'Instrument ',_inst,' not recognized.  Adding to instruments table.'
            insert_values('instruments',{'name':_inst})
            _instid = query('select id from instruments where name=%s', [_inst])
        dictionary['instrumentid']=str(_instid[0]['id'])

    newdict = dict()
    for voce in dictionary:
        if dictionary[voce]: # get rid of empty string entries
            newdict[voce] = dictionary[voce]

    if dbentry_exists and not _force:
            print 'updating database'
            for voce in newdict: query('update spec set ' + voce + '=%s where filename=%s', [newdict[voce], filename])
    else:
        if dbentry_exists:
            print 'replacing database entry'
            query('delete from spec where filename=%s', [filename])
        else: print 'adding to database'
        insert_values('spec',newdict)
    if post == 'nosnex':
        note += 'not posted to SNEx (--post nosnex)\n'
    else:
        note += post_to_snex(directory + _output, dictionary, adding, hdr.get('PROPID'), post)
    return note

DEFAULT_GROUPIDCODE = 1703768065789

def get_fullname():
    try:
        rows = query('select firstname, lastname from users where name=%s', [getpass.getuser()])
    except Exception:
        return None
    if rows and rows[0]['firstname']:
        return ' '.join(n for n in (rows[0]['firstname'], rows[0]['lastname']) if n)
    return None

def groups_for(groupidcode):
    groupidcode = int(groupidcode or DEFAULT_GROUPIDCODE)
    return [{'name': g['name']} for g in query('select name, idcode from `groups`')
            if g['idcode'] and int(g['idcode']) & groupidcode == int(g['idcode'])]

def post_with_groups(groups, post):
    default_groups = groups_for(None) or None
    response = post(groups or default_groups)
    if response.status_code == 400 and 'does not exist' in response.text:
        print response.text[:300] + '; using the default groups'
        response = post(default_groups)
    response.raise_for_status()
    return response.json()

def post_public(post):
    response = post([])
    response.raise_for_status()
    return response.json()

def post_to_snex(filepath, dictionary, adding=False, propid=None, post='add'):
    note = ''
    url = os.environ.get('SNEX_URL', 'https://supernova.exchange').rstrip('/')
    token = os.environ.get('SNEX_API_TOKEN', '')
    if not url or not token:
        return 'ERROR: SNEX_URL and SNEX_API_TOKEN must be set, not posted to SNEx\n'
    headers = {'Accept': 'application/json', 'Authorization': 'Token ' + token}
    try:
        targetid = int(dictionary['targetid'])
        standard = propid == 'FLOYDS standards' or bool(query('select targets.id from targets join classifications on classifications.id=targets.classificationid '
                'where targets.id=%s and classifications.name="Standard"', [targetid]))

        target_row = query('select groupidcode from targets where id=%s', [targetid])
        target_groups = groups_for(target_row[0]['groupidcode'] if target_row else None)
        raw = query('select groupidcode from speclcoraw where filename=%s', [dictionary['original']]) if dictionary.get('original') else ()
        spec_groups = groups_for((raw[0]['groupidcode'] if raw else None) or dictionary.get('groupidcode'))

        names = [dictionary['objname']]
        for n in query('select name from targetnames where targetid=%s order by id', [targetid]):
            if n['name'].replace(' ', '').lower() not in [m.replace(' ', '').lower() for m in names]:
                names.append(n['name'])
        target_params = {'name': names[0], 'type': 'SIDEREAL', 'permissions': 'PRIVATE',
                         'ra': float(dictionary['ra0']), 'dec': float(dictionary['dec0']),
                         'aliases': [{'name': n} for n in names[1:]], 'standard': standard,
                         'comment': 'Target created by the pipeline'}

        def post_target(groups):
            return requests.post(url + '/api/targets/', headers=headers,
                                 json=target_params if groups is None else dict(target_params, groups=groups))
        target_id = (post_public(post_target) if standard else post_with_groups(target_groups, post_target))['id']
        note += 'SNEx target id = ' + str(target_id) + '\n'

        params = {'target': target_id, 'data_product_type': 'spectroscopy'}
        if post == 'replace':
            params['replace'] = 'true'
        if dictionary.get('original'):
            params['product_id'] = re.sub(r'\.fits$', '', dictionary['original'])
        elif adding:
            params['product_id'] = os.path.splitext(os.path.basename(filepath))[0]
        if dictionary.get('reducer'):
            params['reducer'] = dictionary['reducer']

        def post_spectrum(groups):
            with open(filepath, 'rb') as f:
                return requests.post(url + '/api/dataproducts/', headers=headers, data=params if groups is None else dict(params, groups=json.dumps(groups)),
                                     files={'file': (os.path.basename(filepath), f, 'image/fits')})
        dp = post_public(post_spectrum) if standard else post_with_groups(spec_groups, post_spectrum)
        if dp.get('unchanged'):
            note += 'SNEx data product = ' + str(dp['id']) + ' (this version was already posted)\n'
        else:
            note += 'SNEx data product = ' + str(dp['id']) + ' (version ' + str(dp['versions']) + ')\n'
            note += 'SNEx groups = ' + ', '.join(dp['groups']) + '\n'
    except Exception as e:
        detail = getattr(getattr(e, 'response', None), 'text', '')
        note += 'WARNING: SNEx upload failed: ' + str(e) + ' ' + detail[:300] + '\n'
    return note

if __name__ == "__main__":
    parser = ArgumentParser(description="archive a reduced spectrum")
    parser.add_argument("filenames", nargs='+', help="spectra to archive")
    parser.add_argument("-o", "--output", default='', help='output filename')
    parser.add_argument("-f", "--force", action="store_true", help="overwrite existing file & db entry")
    parser.add_argument("-r", "--reducer", help="name of reducer")
    parser.add_argument("--post", choices=['add', 'replace', 'nosnex'], default='add',
                        help='add: post to SNEx as a new version (default); replace: replace the versions already in SNEx; '
                             'nosnex: archive without posting to SNEx')
    args = parser.parse_args()

    fullname = get_fullname()

    for img in args.filenames:
        note = uploadspectrum(img, args.output, args.force, args.reducer, args.post)
        print note
